% =============================================================================
% wasedaThesisMaster.sty
% LaTeX Style Package for Master's Thesis at Waseda University, FSE
%
% Author:  Haoyuan Liu (Initial: 2023-06-30, Revised: 2026-05)
%
% Description:
%   Formatting package for a Master's thesis submitted to the Graduate School
%   of Fundamental Science and Engineering (FSE) at Waseda University.
%
%   Designed for the 'report' document class, which provides full
%   \chapter / \section / \subsection hierarchy suitable for theses.
%   Visual layout is kept consistent with the original article-based version.
%
% Usage:
%   \documentclass[12pt, a4paper]{report}
%   \usepackage{wasedaThesisMaster}
%
% Cover page usage:
%   \makecover{Title}{Author}{Student ID}{Advisor}{Research Guidance}{Date}
% =============================================================================
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{wasedaThesisMaster}[2026/05/21 Waseda FSE Master Thesis Style]

% ======================= Page Layout ========================================
\RequirePackage[
  a4paper,
  left=3.18cm,
  right=3.18cm,
  top=2.54cm,
  bottom=2.54cm
]{geometry}

% ======================= Fonts ==============================================
% newtxtext + newtxmath: modern replacement for the obsolete mathptmx
\RequirePackage{amssymb}
\RequirePackage{newtxtext}
\RequirePackage{newtxmath}

% ======================= Line Spacing =======================================
\RequirePackage{setspace}
\setstretch{1.5}  % equivalent to \renewcommand{\baselinestretch}{1.5}

% ======================= Paragraph Formatting ===============================
\RequirePackage{indentfirst}

% ======================= Chapter / Section Formatting =======================
\RequirePackage{titlesec}

% -- Chapter title style (label and title on the same line) --
\newif\if@centerchaptitle
\@centerchaptitlefalse

\titleformat{\chapter}[hang]
  {\normalfont\LARGE\bfseries\if@centerchaptitle\centering\fi}  % format applied to both label and title
  {Chapter\ \thechapter\enspace}% label  (\enspace = thin space before title)
  {0pt}                         % sep (0pt because \enspace is already in label)
  {}                            % before-code
\titlespacing*{\chapter}{0pt}{-20pt}{20pt}  % reduce top whitespace

% -- Section spacing tweaks (preserve the 0.3em gap from the original) --
\titleformat{\section}
  {\normalfont\large\bfseries}
  {\thesection}{0.3em}{}
\titleformat{\subsection}
  {\normalfont\normalsize\bfseries}
  {\thesubsection}{0.3em}{}
\titleformat{\subsubsection}
  {\normalfont\normalsize\itshape}
  {\thesubsubsection}{0.3em}{}

% ======================= Caption Formatting =================================
\RequirePackage{caption}
\renewcommand{\figurename}{Fig.}
\renewcommand{\tablename}{Table}
\captionsetup[figure]{
  font      = small,
  labelfont = bf,
  labelsep  = period,
}
\captionsetup[table]{
  font      = small,
  labelfont = bf,
  labelsep  = period,
}

% ======================= Header / Footer ====================================
\RequirePackage{fancyhdr}

% default page style
\pagestyle{fancy}
\fancyhf{}
\fancyhead[L]{\nouppercase{\leftmark}}  % chapter title in header
\fancyhead[R]{\thepage}
\renewcommand{\headrulewidth}{0.4pt}
\renewcommand{\footrulewidth}{0pt}

% plain style (used on chapter-opening pages)
\fancypagestyle{plain}{%
  \fancyhf{}%
  \fancyfoot[C]{\thepage}%
  \renewcommand{\headrulewidth}{0pt}%
}

% ======================= Table of Contents ==================================
\RequirePackage{tocloft}

% -- Title names (keep "List of Content" as in original master's version) --
\renewcommand{\contentsname}{List of Content}
\renewcommand{\listfigurename}{List of Figures}
\renewcommand{\listtablename}{List of Tables}

\renewcommand{\cfttoctitlefont}{\hfil\Large\bfseries}
\renewcommand{\cftloftitlefont}{\hfil\Large\bfseries}
\renewcommand{\cftlottitlefont}{\hfil\Large\bfseries}
\renewcommand{\cftaftertoctitle}{\vspace{0.5cm}}
\renewcommand{\cftafterloftitle}{\vspace{0.5cm}}
\renewcommand{\cftafterlottitle}{\vspace{0.5cm}}

% -- Figure list: "Fig. X  title ............. page" --
\setlength{\cftfigindent}{0pt}
\renewcommand{\cftfigpresnum}{\bfseries Fig.\ }
\setlength{\cftfignumwidth}{4em}

% -- Table list: "Table X  title ............. page" --
\setlength{\cfttabindent}{0pt}
\renewcommand{\cfttabpresnum}{\bfseries Table\ }
\setlength{\cfttabnumwidth}{4.5em}

% -- Spacing: tighten TOC / LoF / LoT entry gaps --
\setlength{\cftbeforechapskip}{0.15em}  % space before each chapter entry in TOC
\setlength{\cftbeforesecskip}{0.05em}   % space before each section entry in TOC
\setlength{\cftbeforefigskip}{0.05em}   % space between entries in LoF
\setlength{\cftbeforetabskip}{0.05em}   % space between entries in LoT

% -- Generate all lists and switch to arabic numbering --
\newcommand{\makecontent}{%
  \tableofcontents%
  \addcontentsline{toc}{chapter}{List of Content}%
  \clearpage
  \listoffigures%
  \addcontentsline{toc}{chapter}{List of Figures}%
  \clearpage
  \listoftables%
  \addcontentsline{toc}{chapter}{List of Tables}%
  \clearpage
}

% ======================= Cover Page =========================================
% Usage:
%   \makecover{Title}{Author}{Student ID}{Advisor}{Research Guidance}{Date}
%
\newcommand{\makecover}[6]{%
  \begin{titlepage}
    \centering
    \vspace*{65mm}
    {\Large\bfseries #1\par}%                             % title
    \vspace{20mm}
    {\normalsize
      A Thesis Submitted to \\
      the Department of Computer Science and Communications Engineering,\\
      the Graduate School of Fundamental Science and Engineering of Waseda University \\
      in Partial Fulfillment of the Requirements for the Degree of Master of Engineering%
    \par}
    \vspace{1em}
    {\normalsize #6\par}%                                  % date
    \vfill
    {\normalsize
      #2\\%                                                % author
      (#3)\\%                                              % student ID
      Advisor: #4\\%                                       % advisor
      Research guidance: #5%                               % research guidance
    \par}
  \end{titlepage}
}

% ======================= Front Matter Environments ==========================
% Switch to roman page numbering for front matter.
% Call \mainmatter before Chapter 1.

\newcommand{\frontmatter}{%
  \cleardoublepage
  \pagenumbering{roman}%
}
\newcommand{\mainmatter}{%
  \cleardoublepage
  \pagenumbering{arabic}%
}
\newcommand{\backmatter}{%
  \cleardoublepage
}

% -- Acknowledgements --
\newenvironment{acknowledgements}{%
  \@centerchaptitletrue
  \chapter*{Acknowledgements}%
  \@centerchaptitlefalse
  \addcontentsline{toc}{chapter}{Acknowledgements}%
}{%
  \clearpage
}

% -- Abstract (report class already defines this, so we override) --
\renewenvironment{abstract}{%
  \@centerchaptitletrue
  \chapter*{Abstract}%
  \@centerchaptitlefalse
  \addcontentsline{toc}{chapter}{Abstract}%
}{%
  \clearpage
}

% -- Keywords (use inside abstract environment) --
\newcommand{\keywords}[1]{%
  \par\vspace{0.5em}%
  \noindent\textbf{Keywords:}\ #1%
}

% ======================= Bibliography =======================================
% Add bibliography to TOC automatically
\RequirePackage[nottoc]{tocbibind}

% ======================= Hyperlinks (load last) =============================
\RequirePackage[
  colorlinks        = true,
  linkcolor         = black,
  citecolor         = black,
  urlcolor          = blue,
  bookmarks         = true,
  bookmarksnumbered = true,
]{hyperref}

\endinput